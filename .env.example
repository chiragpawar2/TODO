# Copy to .env and fill in the key for whichever engine you chose in config.yaml.
# .env is gitignored - never commit your real key.

# engine: gemini   (free)  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# engine: groq     (free)  -> https://console.groq.com/keys
# GROQ_API_KEY=

# engine: openrouter (free) -> https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# engine: cerebras (free)  -> https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# engine: ollama - no key needed, it runs on your own machine

# engine: claude   (paid)  -> https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
